# API del banco (fuente de verdad, backend-banco en Vercel)
BANCO_API_URL=https://api.banco.laplaceta.org

# Boletín Oficial de La Placeta (valores CNIC en vivo; página /normativa)
BOP_URL=https://bop.laplaceta.org

# Puerto local
PORT=3003
