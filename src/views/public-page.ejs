<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#160c29"><meta name="description" content="<%= description %>"><title><%= title %> · Banco de La Placeta</title><link rel="icon" href="/brand/icon.png"><link rel="stylesheet" href="/css/public-site.css"></head><body>
<header class="pub-nav"><div class="wrap pub-nav-inner"><a class="pub-brand" href="/"><img src="/brand/icon.png" alt=""><div><strong>Banco de La Placeta</strong><span>Economía virtual comunitaria</span></div></a><nav class="pub-links" aria-label="Navegación pública"><a href="/ecosistema">Ecosistema</a><a href="/placezum">PlaceZUM</a><a href="/seguridad">Seguridad</a><a class="pub-cta" href="/login">Entrar con PlacetaID</a></nav></div></header>
<main><section class="pub-hero"><div class="wrap pub-hero-grid"><div><p class="pub-eyebrow"><%= eyebrow %></p><h1><%= title %></h1><p class="pub-hero-lead"><%= intro %></p><div class="pub-actions"><a class="pub-btn pub-btn-primary" href="/login">Acceder al banco</a><a class="pub-btn pub-btn-ghost" href="/"><%= backLabel %></a></div></div><div class="pub-showcase"><div class="pub-logo-panel"><img src="/brand/logo.png" alt="Banco de La Placeta"></div><h2><%= showcaseTitle %></h2><p><%= showcaseText %></p></div></div></section><section class="pub-section"><div class="wrap"><div class="pub-heading"><p class="pub-eyebrow" style="color:var(--p)"><%= sectionEyebrow %></p><h2><%= sectionTitle %></h2><p><%= sectionIntro %></p></div><div class="pub-grid"><% cards.forEach(function(card){ %><article class="pub-card"><div class="pub-card-icon"><% if(card.icon === 'zum'){ %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 9h8l-8 6h8"/></svg><% } else if(card.icon === 'shield'){ %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg><% } else if(card.icon === 'users'){ %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2M16 3.1a4 4 0 0 1 0 7.8"/></svg><% } else if(card.icon === 'chart'){ %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 16 4-5 3 3 5-7"/></svg><% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg><% } %></div><h3><%= card.title %></h3><p><%= card.text %></p></article><% }) %></div></div></section></main><footer class="pub-footer"><div class="wrap pub-footer-inner"><span>© Banco de La Placeta · Economía virtual sin ánimo de lucro</span><div class="pub-footer-links"><a href="/">Inicio</a><a href="https://bolp.laplaceta.org" target="_blank" rel="noopener">BOLP</a><a href="/login">Acceso seguro</a></div></div></footer></body></html>
