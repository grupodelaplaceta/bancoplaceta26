<div class="bw-page">
  <div class="bw-header">
    <div>
      <h1>PlaceZUM</h1>
      <p class="bw-sub">Envía Placetas a varios destinatarios en un solo zum</p>
    </div>
  </div>

  <% if (resultado) { %>
    <div class="bw-banner bw-banner-ok" style="margin-bottom:14px">
      ✅ <%= resultado.mensaje %>
      <div class="bw-muted" style="margin-top:4px">
        Total <strong><%= resultado.total.toLocaleString('es-ES') %> Pz</strong> · <%= resultado.enviados %> destinatario(s) · zum <code><%= resultado.id %></code>
      </div>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="bw-alert bw-alert-error" style="margin-bottom:14px"><%= error %></div>
  <% } %>

  <div class="bw-card">
    <form method="post" action="/placezum">
      <div class="bw-account-top" style="margin-bottom:10px"><strong>Nuevo envío</strong></div>

      <label class="bw-muted" style="display:block;margin-bottom:4px">Cuenta de origen</label>
      <select name="from" style="width:100%;padding:10px;border-radius:10px;margin-bottom:14px">
        <% cuentas.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= c.id === cuentaActiva ? 'selected' : '' %>><%= c.displayName %> · <%= (c.balancePz || 0).toLocaleString('es-ES') %> Pz</option>
        <% }) %>
      </select>

      <label class="bw-muted" style="display:block;margin-bottom:4px">Destinatarios (uno por línea: IBAN/DIP y cantidad)</label>
      <textarea name="destinatarios" rows="6" placeholder="GDLP-AP00-000 100&#10;GDLP-AP11-111 50" style="width:100%;padding:10px;border-radius:10px;margin-bottom:14px;font-family:monospace"></textarea>

      <button class="bw-btn bw-btn-primary bw-btn-block" type="submit">Enviar PlaceZUM</button>
    </form>
  </div>
</div>
