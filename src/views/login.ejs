<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar sesión · Banco de La Placeta</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bw-theme bw-login-body">
  <div class="bw-login-card">
    <div class="bw-brand bw-login-brand">
      <span class="bw-brand-mark" style="margin:0 auto">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V19a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5"/><path d="M9 20v-6h6v6"/></svg>
      </span>
      <h1>Banco de La Placeta</h1>
      <p>Accede con tu identidad PlacetaID</p>
    </div>
    <% if (error) { %>
      <div class="bw-alert bw-alert-error">No se pudo iniciar sesión. Inténtalo de nuevo.</div>
    <% } %>
    <a class="bw-btn bw-btn-primary bw-btn-block" href="<%= loginUrl %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Iniciar sesión con PlacetaID
    </a>
    <p class="bw-login-foot">La identidad y el segundo factor se gestionan en <strong>PlacetaID</strong> (id.laplaceta.org).</p>
  </div>
</body>
</html>
