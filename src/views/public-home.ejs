<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#150259">
  <meta name="description" content="Banco de La Placeta: economía virtual sin ánimo de lucro que conecta proyectos y comunidad.">
  <title>Banco de La Placeta · Economía que conecta</title>
  <link rel="icon" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat+Alternates:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/public-site.css">
  <style>
    :root{--purple:#3204D9;--violet:#6B7FF2;--ink:#150259;--dark:#150259;--soft:#f4f5ff;--muted:#4f4a73;--line:#ddddf4}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:'Plus Jakarta Sans',sans-serif;background:#fff}h1,h2,h3,a,button{font-family:'Montserrat Alternates',sans-serif}a{text-decoration:none;color:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}
    .nav{position:relative;z-index:3;color:#fff;background:var(--dark)}.nav-inner{height:78px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px}.brand-logo{display:block;width:min(100%,220px);height:auto;object-fit:contain}.brand strong{display:block;font-size:15px}.brand span{display:block;font-family:'Plus Jakarta Sans';font-size:11px;color:#ddd0ebaa;margin-top:2px}.nav-links{display:flex;align-items:center;gap:28px;font-size:14px;font-weight:700;color:#f0ecff}.nav-links a{transition:color .2s ease,transform .2s ease}.nav-links a:hover{color:#fff;transform:translateY(-1px)}.nav-cta{display:inline-flex;align-items:center;gap:9px;padding:13px 19px;border-radius:14px;background:#fff;color:var(--purple);box-shadow:0 10px 24px #15025945;font-size:13px}.nav-cta::after{content:'→';font-size:18px;line-height:0;transition:transform .2s ease}.nav-cta:hover::after{transform:translateX(3px)}
    .hero{position:relative;overflow:hidden;min-height:690px;padding:150px 0 90px;color:#fff;background:radial-gradient(circle at 85% 20%,#2E06BF 0,transparent 28%),linear-gradient(135deg,#150259,#21038C 58%,#3204D9)}.hero:after,.hero:before{content:"";position:absolute;border:1px solid #ffffff20;border-radius:50%;pointer-events:none}.hero:after{width:540px;height:540px;right:-160px;top:110px}.hero:before{width:310px;height:310px;right:-45px;top:225px}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:70px;align-items:center;position:relative;z-index:1}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:#6B7FF2;margin:0 0 18px}.hero h1{font-size:clamp(38px,6vw,70px);line-height:1.04;letter-spacing:-.06em;margin:0;max-width:700px}.hero h1 em{font-style:normal;color:#6B7FF2}.hero p{font-size:17px;line-height:1.7;color:#eee5f8cc;max-width:590px;margin:24px 0 30px}.actions{display:flex;flex-wrap:wrap;gap:12px}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:14px;padding:14px 20px;font-size:13px;font-weight:800}.btn-primary{background:#fff;color:var(--purple)}.btn-ghost{border:1px solid #ffffff40;color:#fff;background:#ffffff0d}.hero-card{position:relative;min-height:350px;padding:25px;border:1px solid #ffffff24;border-radius:28px;background:#ffffff12;backdrop-filter:blur(14px);box-shadow:0 28px 70px #08031155}.hero-logo{width:105px;height:105px;padding:18px;border-radius:28px;background:#fff;margin-bottom:32px}.hero-logo img{width:100%;height:100%;object-fit:contain}.hero-card h2{font-size:25px;line-height:1.2;margin:0 0 12px}.hero-card p{font-size:13px;margin:0;line-height:1.6}.metric{display:flex;gap:10px;margin-top:30px}.metric div{padding:11px 13px;border-radius:13px;background:#ffffff12;border:1px solid #ffffff1d;font-size:11px;color:#eadff5}.metric b{display:block;color:#fff;font-size:18px;margin-bottom:3px}
    .section{padding:104px 0}.section.alt{background:linear-gradient(180deg,var(--soft),#fff)}.section-head{max-width:700px;margin-bottom:42px}.section h2{font-size:clamp(30px,4vw,48px);line-height:1.08;letter-spacing:-.05em;margin:0 0 14px}.section-head p{color:var(--muted);line-height:1.75;margin:0;font-size:15px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card{padding:28px;border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:0 12px 30px #1502590a;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.card:hover{transform:translateY(-4px);border-color:#6B7FF266;box-shadow:0 18px 36px #15025918}.card-icon{display:grid;place-items:center;width:50px;height:50px;border-radius:16px;background:#eef0ff;color:var(--purple);font-size:20px;margin-bottom:22px}.card-icon svg{width:24px;height:24px}.card h3{font-size:19px;margin:0 0 10px}.card p{font-size:14px;line-height:1.7;color:var(--muted);margin:0}.cards .card:nth-child(1){background:linear-gradient(145deg,#fff 0%,#f6f2ff 100%)}.cards .card:nth-child(2){background:linear-gradient(145deg,#fff 0%,#f1f5ff 100%);border-radius:28px 18px 18px 18px}.cards .card:nth-child(3){background:linear-gradient(145deg,#fff 0%,#f4f8ff 100%);border-radius:18px 28px 18px 18px}.cards .card:nth-child(2) .card-icon{background:#e8edff;color:#2E06BF}.cards .card:nth-child(3) .card-icon{background:#e8f0ff;color:#3204D9}.account-cards .card:nth-child(1){border-top:4px solid #3204D9}.account-cards .card:nth-child(2){border-top:4px solid #2E06BF}.account-cards .card:nth-child(3){border-top:4px solid #6B7FF2}.account-cards .card:nth-child(2){border-radius:22px}.account-cards .card:nth-child(3){border-radius:22px}.account-cards .card:hover{transform:translateY(-6px)}.account-cards ul{display:grid;gap:8px;margin:22px 0 0;padding:16px 0 0;border-top:1px solid var(--line);list-style:none;color:var(--muted);font-size:12px;line-height:1.5}.account-cards li{display:flex;gap:8px;align-items:flex-start}.account-cards li::before{content:'✓';color:var(--purple);font-weight:800}.section-note{margin:24px 0 0;color:var(--muted);font-size:12px;line-height:1.6}.mobile-nav-toggle{display:none}.footer{padding:48px 0 20px;border-top:1px solid var(--line);font-size:12px;color:var(--muted);background:#150259}.footer-grid{display:grid;grid-template-columns:minmax(240px,1.4fr) repeat(2,minmax(150px,1fr));gap:48px}.footer-brand img{display:block;width:min(100%,230px);height:auto;margin-bottom:18px}.footer-brand p{max-width:300px;color:#c9c5e8;line-height:1.65;margin:0}.footer-column{display:flex;flex-direction:column;align-items:flex-start;gap:12px}.footer-column strong{color:#fff;font-family:'Montserrat Alternates',sans-serif;font-size:13px;margin-bottom:4px}.footer-column a{color:#c9c5e8;transition:color .2s ease,transform .2s ease}.footer-column a:hover{color:#fff;transform:translateX(2px)}.footer-bottom{display:flex;justify-content:space-between;gap:20px;padding-top:28px;margin-top:42px;border-top:1px solid #ffffff24;color:#aaa7cd}.footer-inner{display:flex;justify-content:space-between;gap:20px;align-items:center}.footer-links{display:flex;gap:16px;flex-wrap:wrap}.footer a:hover{color:var(--purple)}
    @media(max-width:800px){.nav-inner{position:relative}.mobile-nav-toggle{display:flex;flex-direction:column;justify-content:center;gap:4px;width:42px;height:42px;padding:9px;border:1px solid #ffffff40;border-radius:12px;background:#ffffff12;color:#fff;cursor:pointer}.mobile-nav-toggle span{display:block;width:100%;height:2px;border-radius:2px;background:currentColor;transition:transform .2s ease,opacity .2s ease}.nav.menu-open .mobile-nav-toggle span:nth-child(1){transform:translateY(6px) rotate(45deg)}.nav.menu-open .mobile-nav-toggle span:nth-child(2){opacity:0}.nav.menu-open .mobile-nav-toggle span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}.nav-links{display:none;position:absolute;top:68px;left:0;right:0;z-index:5;flex-direction:column;align-items:stretch;gap:4px;padding:12px;border:1px solid #ffffff24;border-radius:16px;background:#150259f7;box-shadow:0 18px 40px #15025955}.nav.menu-open .nav-links{display:flex}.nav-links a,.nav-cta{width:100%;justify-content:space-between;padding:13px 14px;font-size:13px}.nav-cta{margin-top:4px}.hero{min-height:auto;padding:125px 0 65px}.hero-grid{grid-template-columns:1fr;gap:40px}.hero-card{min-height:0}.cards{grid-template-columns:1fr;gap:14px}.section{padding:68px 0}.section-head{margin-bottom:28px}.section h2{font-size:32px}.card{padding:23px}.footer-grid{grid-template-columns:1fr;gap:28px}.footer-brand img{width:min(100%,250px)}.footer-bottom{align-items:flex-start;flex-direction:column;gap:8px;margin-top:30px}.footer-inner{align-items:flex-start;flex-direction:column}.wrap{width:min(100% - 28px,1160px)}}
    .nav-session{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid #ffffff40;border-radius:999px;color:#fff;background:#ffffff12;font-size:12px}.nav-session-icon{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#fff;color:var(--purple)}.nav-session-icon svg{width:16px;height:16px}
    @media(max-width:800px){.nav-session{width:100%;justify-content:space-between;padding:13px 14px;font-size:13px}}
  </style>
</head>
<body>
  <header class="nav"><div class="wrap nav-inner"><a class="brand" href="/"><img class="brand-logo" src="/img/bancologosobreoscuro.png" alt="Banco de La Placeta"></a><button class="mobile-nav-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="public-menu"><span></span><span></span><span></span></button><nav id="public-menu" class="nav-links" aria-label="Navegación pública"><a href="/ecosistema">Ecosistema</a><a href="/placezum">PlaceZUM</a><a href="/seguridad">Seguridad</a><% if (sessionUser) { %><a class="nav-session" href="/panel" aria-label="Abrir mi banco"><span class="nav-session-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M4 20a8 8 0 0 1 16 0"/></svg></span><span><%= sessionUser.nombre || sessionUser.dip %></span></a><% } else { %><a class="nav-cta" href="/login">Entrar con PlacetaID</a><% } %></nav></div></header>
  <main>
    <section class="public-carousel" aria-label="Banner Banco de La Placeta" aria-roledescription="carrusel">
      <div class="carousel-track">
        <article class="carousel-slide is-active" aria-roledescription="diapositiva" aria-label="1 de 2">
          <img src="/img/banne/1.jpg" srcset="/img/banne/1-mobile.jpg 975w, /img/banne/1.jpg 1950w" sizes="(max-width: 780px) 100vw, 100vw" alt="Una economía que conecta proyectos y comunidad" width="1950" height="618" loading="eager" fetchpriority="high" decoding="async">
        </article>
        <article class="carousel-slide" aria-roledescription="diapositiva" aria-label="2 de 2">
          <img src="/img/banne/2.jpg" srcset="/img/banne/2-mobile.jpg 975w, /img/banne/2.jpg 1950w" sizes="(max-width: 780px) 100vw, 100vw" alt="Envía Placetas en un zum" width="1950" height="618" loading="lazy" decoding="async">
        </article>
      </div>
    </section>
    <section class="section" id="ecosistema"><div class="wrap"><div class="section-head"><p class="eyebrow" style="color:var(--purple)">Un solo ecosistema</p><h2>Todo lo importante, en un mismo espacio.</h2><p>Una interfaz diseñada para que cada cuenta, proyecto y operación tenga su lugar, sin mezclar información.</p></div><div class="cards"><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"/><path d="m13 6 6 6-6 6"/><path d="M5 6v12"/></svg></div><h3>PlaceZUM</h3><p>Cobra y envía Placetas con códigos temporales. Cada operación queda vinculada a una cuenta y protegida por los controles del banco.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg></div><h3>Cuentas y proyectos</h3><p>Gestiona cuentas personales, empresas, organismos y cuentas junior con selección de cuenta activa y límites claros.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V7"/><path d="M4 7c4-3 6 3 10 0s6 0 6 0v10c-4 3-6-3-10 0s-6 0-6 0"/></svg></div><h3>Servicios de La Placeta</h3><p>Accede a tributos, subvenciones, facturación, inversiones y documentación desde un entorno común.</p></article></div></div></section>
    <section class="section" id="cuentas"><div class="wrap"><div class="section-head"><p class="eyebrow" style="color:var(--purple)">Cuentas para cada proyecto</p><h2>Elige la cuenta que encaja contigo.</h2><p>La disponibilidad y los límites dependen de la normativa aplicable y de la verificación realizada por PlacetaID.</p></div><div class="cards account-cards"><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M4 20a8 8 0 0 1 16 0"/></svg></div><h3>Cuenta personal</h3><p>Para personas titulares o cotitulares que gestionan sus Placetas y servicios del ecosistema.</p><ul><li>PlacetaID verificado.</li><li>Datos personales actualizados.</li><li>Aceptación de los términos de uso.</li></ul></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V5l7-3 7 3v16M9 9h1M14 9h1M9 13h1M14 13h1M9 17h1M14 17h1"/></svg></div><h3>Cuenta de empresa</h3><p>Para sociedades, proyectos y entidades con una persona autorizada para operar.</p><ul><li>Identidad del representante.</li><li>Datos de la entidad y titularidad.</li><li>Documentación de autorización.</li></ul></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.2 7.7 8 9 4.8-1.3 8-4.5 8-9V6l-8-3Z"/><path d="M9 12h6M12 9v6"/></svg></div><h3>Cuenta junior</h3><p>Para menores de 16 años, siempre bajo el sistema Placeta Junior y la supervisión correspondiente.</p><ul><li>Alta y autorización del responsable.</li><li>Uso limitado según las reglas junior.</li><li>No sustituye una cuenta adulta.</li></ul></article></div><p class="section-note">Los requisitos pueden ampliarse durante la verificación. Consulta la información vigente en BOLP antes de solicitar una cuenta.</p></div></section>
    <section class="section alt" id="seguridad"><div class="wrap"><div class="section-head"><p class="eyebrow" style="color:var(--purple)">Diseñado para confiar</p><h2>Claridad antes de cada operación.</h2><p>La seguridad no debe complicar la experiencia. Por eso mostramos el estado, la cuenta activa y los datos relevantes en cada paso.</p></div><div class="cards"><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.2 7.7 8 9 4.8-1.3 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></div><h3>Identidad PlacetaID</h3><p>El acceso se realiza mediante la identidad oficial de La Placeta, sin exponer credenciales en el banco.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m8 12 2.5 2.5L16 9"/></svg></div><h3>Operaciones verificadas</h3><p>Los enlaces, transferencias y códigos temporales se validan antes de mostrar o aplicar una operación.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l3 3v15H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v4h4M8 12h8M8 16h6"/></svg></div><h3>Información trazable</h3><p>Movimientos, declaraciones y documentos relevantes se organizan para que puedas consultarlos con contexto.</p></article></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-grid"><div class="footer-brand"><img src="/img/bancologosobreblanco.png" alt="Banco de La Placeta"><p>Economía virtual sin ánimo de lucro que conecta proyectos y comunidad.</p></div><div class="footer-column"><strong>Explora</strong><a href="/ecosistema">Ecosistema</a><a href="/placezum">PlaceZUM</a><a href="#cuentas">Tipos de cuenta</a><a href="/seguridad">Seguridad</a></div><div class="footer-column"><strong>Información</strong><a href="/sobre-el-banco">Sobre el banco</a><a href="https://bolp.laplaceta.org" target="_blank" rel="noopener">BOLP</a><a href="/login">Acceso con PlacetaID</a></div></div><div class="wrap footer-bottom"><span>© Banco de La Placeta · Economía virtual sin ánimo de lucro</span><span>Web y app con la misma experiencia</span></div></footer>
<script>
const publicNav = document.querySelector('.nav');
const publicNavToggle = document.querySelector('.mobile-nav-toggle');
if (publicNav && publicNavToggle) {
  publicNavToggle.addEventListener('click', () => {
    const open = publicNav.classList.toggle('menu-open');
    publicNavToggle.setAttribute('aria-expanded', String(open));
    publicNavToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  });
  document.querySelectorAll('#public-menu a').forEach((link) => link.addEventListener('click', () => {
    publicNav.classList.remove('menu-open');
    publicNavToggle.setAttribute('aria-expanded', 'false');
    publicNavToggle.setAttribute('aria-label', 'Abrir menú');
  }));
}
(() => {
  const slides = [...document.querySelectorAll('.carousel-slide')];
  const dots = [...document.querySelectorAll('.carousel-dot')];
  if (slides.length < 2) return;
  let current = 0;
  const show = (next) => {
    current = (next + slides.length) % slides.length;
    slides.forEach((slide, index) => slide.classList.toggle('is-active', index === current));
    dots.forEach((dot, index) => { dot.classList.toggle('is-active', index === current); dot.setAttribute('aria-selected', index === current ? 'true' : 'false'); });
  };
  dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
  window.setInterval(() => show(current + 1), 7000);
})();
</script>
</body>
</html>
