  <link href="https://fonts.googleapis.com/css2?family=Montserrat+Alternates:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/public-site.css">
  <style>
    :root{--purple:#3204D9;--violet:#6B7FF2;--ink:#150259;--dark:#150259;--soft:#f4f5ff;--muted:#4f4a73;--line:#ddddf4}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:'Plus Jakarta Sans',sans-serif;background:#fff}h1,h2,h3,a,button{font-family:'Montserrat Alternates',sans-serif}a{text-decoration:none;color:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}
    .nav{position:relative;z-index:3;color:#fff;background:var(--dark)}.nav-inner{height:78px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px}.brand-logo{display:block;width:min(100%,220px);height:auto;object-fit:contain}.brand strong{display:block;font-size:15px}.brand span{display:block;font-family:'Plus Jakarta Sans';font-size:11px;color:#ddd0ebaa;margin-top:2px}.nav-links{display:flex;align-items:center;gap:28px;font-size:14px;font-weight:700;color:#f0ecff}.nav-links a{transition:color .2s ease,transform .2s ease}.nav-links a:hover{color:#fff;transform:translateY(-1px)}.nav-cta{display:inline-flex;align-items:center;gap:9px;padding:13px 19px;border-radius:14px;background:#fff;color:var(--purple);box-shadow:0 10px 24px #15025945;font-size:13px}.nav-cta::after{content:'→';font-size:18px;line-height:0;transition:transform .2s ease}.nav-cta:hover::after{transform:translateX(3px)}
    .hero{position:relative;overflow:hidden;min-height:690px;padding:150px 0 90px;color:#fff;background:radial-gradient(circle at 85% 20%,#2E06BF 0,transparent 28%),linear-gradient(135deg,#150259,#21038C 58%,#3204D9)}.hero:after,.hero:before{content:"";position:absolute;border:1px solid #ffffff20;border-radius:50%;pointer-events:none}.hero:after{width:540px;height:540px;right:-160px;top:110px}.hero:before{width:310px;height:310px;right:-45px;top:225px}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:70px;align-items:center;position:relative;z-index:1}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:#6B7FF2;margin:0 0 18px}.hero h1{font-size:clamp(38px,6vw,70px);line-height:1.04;letter-spacing:-.06em;margin:0;max-width:700px}.hero h1 em{font-style:normal;color:#6B7FF2}.hero p{font-size:17px;line-height:1.7;color:#eee5f8cc;max-width:590px;margin:24px 0 30px}.actions{display:flex;flex-wrap:wrap;gap:12px}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:14px;padding:14px 20px;font-size:13px;font-weight:800}.btn-primary{background:#fff;color:var(--purple)}.btn-ghost{border:1px solid #ffffff40;color:#fff;background:#ffffff0d}.hero-card{position:relative;min-height:350px;padding:25px;border:1px solid #ffffff24;border-radius:28px;background:#ffffff12;backdrop-filter:blur(14px);box-shadow:0 28px 70px #08031155}.hero-logo{width:105px;height:105px;padding:18px;border-radius:28px;background:#fff;margin-bottom:32px}.hero-logo img{width:100%;height:100%;object-fit:contain}.hero-card h2{font-size:25px;line-height:1.2;margin:0 0 12px}.hero-card p{font-size:13px;margin:0;line-height:1.6}.metric{display:flex;gap:10px;margin-top:30px}.metric div{padding:11px 13px;border-radius:13px;background:#ffffff12;border:1px solid #ffffff1d;font-size:11px;color:#eadff5}.metric b{display:block;color:#fff;font-size:18px;margin-bottom:3px}
    .section{padding:104px 0}.section.alt{background:linear-gradient(180deg,var(--soft),#fff)}.section-head{max-width:700px;margin-bottom:42px}.section h2{font-size:clamp(30px,4vw,48px);line-height:1.08;letter-spacing:-.05em;margin:0 0 14px}.section-head p{color:var(--muted);line-height:1.75;margin:0;font-size:15px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card{padding:28px;border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:0 12px 30px #1502590a;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.card:hover{transform:translateY(-4px);border-color:#6B7FF266;box-shadow:0 18px 36px #15025918}.card-icon{display:grid;place-items:center;width:50px;height:50px;border-radius:16px;background:#eef0ff;color:var(--purple);font-size:20px;margin-bottom:22px}.card-icon svg{width:24px;height:24px}.card h3{font-size:19px;margin:0 0 10px}.card p{font-size:14px;line-height:1.7;color:var(--muted);margin:0}.footer{padding:34px 0;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}.footer-inner{display:flex;justify-content:space-between;gap:20px;align-items:center}.footer-links{display:flex;gap:16px;flex-wrap:wrap}.footer a:hover{color:var(--purple)}
    @media(max-width:800px){.nav-links{gap:10px;font-size:12px}.nav-cta{padding:11px 13px;font-size:11px}.nav-cta::after{font-size:16px}.hero{min-height:auto;padding:125px 0 65px}.hero-grid{grid-template-columns:1fr;gap:40px}.hero-card{min-height:0}.cards{grid-template-columns:1fr;gap:14px}.section{padding:68px 0}.section-head{margin-bottom:28px}.section h2{font-size:32px}.card{padding:23px}.footer-inner{align-items:flex-start;flex-direction:column}.wrap{width:min(100% - 28px,1160px)}}
  </style>
</head>
<body>
  <header class="nav"><div class="wrap nav-inner"><a class="brand" href="/"><img class="brand-logo" src="/img/bancologosobreoscuro.png" alt="Banco de La Placeta"></a><nav class="nav-links" aria-label="Navegación pública"><a href="/ecosistema">Ecosistema</a><a href="/seguridad">Seguridad</a><a class="nav-cta" href="/login">Entrar con PlacetaID</a></nav></div></header>
  <main>
    <section class="public-carousel" aria-label="Banner Banco de La Placeta" aria-roledescription="carrusel">
      <div class="carousel-track">
        <article class="carousel-slide is-active" aria-roledescription="diapositiva" aria-label="1 de 1">
          <img src="/img/banne/1.jpg" srcset="/img/banne/1-mobile.jpg 975w, /img/banne/1.jpg 1950w" sizes="(max-width: 780px) 100vw, 100vw" alt="Una economía que conecta proyectos y comunidad" width="1950" height="618" loading="eager" fetchpriority="high" decoding="async">
        </article>
      </div>
    </section>
    <section class="section" id="ecosistema"><div class="wrap"><div class="section-head"><p class="eyebrow" style="color:var(--purple)">Un solo ecosistema</p><h2>Todo lo importante, en un mismo espacio.</h2><p>Una interfaz diseñada para que cada cuenta, proyecto y operación tenga su lugar, sin mezclar información.</p></div><div class="cards"><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"/><path d="m13 6 6 6-6 6"/><path d="M5 6v12"/></svg></div><h3>PlaceZUM</h3><p>Cobra y envía Placetas con códigos temporales. Cada operación queda vinculada a una cuenta y protegida por los controles del banco.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg></div><h3>Cuentas y proyectos</h3><p>Gestiona cuentas personales, empresas, organismos y cuentas junior con selección de cuenta activa y límites claros.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V7"/><path d="M4 7c4-3 6 3 10 0s6 0 6 0v10c-4 3-6-3-10 0s-6 0-6 0"/></svg></div><h3>Servicios de La Placeta</h3><p>Accede a tributos, subvenciones, facturación, inversiones y documentación desde un entorno común.</p></article></div></div></section>
    <section class="section alt" id="seguridad"><div class="wrap"><div class="section-head"><p class="eyebrow" style="color:var(--purple)">Diseñado para confiar</p><h2>Claridad antes de cada operación.</h2><p>La seguridad no debe complicar la expe
riencia. Por eso mostramos el estado, la cuenta activa y los datos relevantes en cada paso.</p></div><div class="cards"><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.2 7.7 8 9 4.8-1.3 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></div><h3>Identidad PlacetaID</h3><p>El acceso se realiza mediante la identidad oficial de La Placeta, sin exponer credenciales en el banco.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m8 12 2.5 2.5L16 9"/></svg></div><h3>Operaciones verificadas</h3><p>Los enlaces, transferencias y códigos temporales se validan antes de mostrar o aplicar una operación.</p></article><article class="card"><div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l3 3v15H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v4h4M8 12h8M8 16h6"/></svg></div><h3>Información trazable</h3><p>Movimientos, declaraciones y documentos relevantes se organizan para que puedas consultarlos con contexto.</p></article></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-inner"><span>© Banco de La Placeta · Economía virtual sin ánimo de lucro</span><div class="footer-links"><a href="/ecosistema">Ecosistema</a><a href="/placezum">PlaceZUM</a><a href="/seguridad">Seguridad</a><a href="/login">PlacetaID</a><a href="https://bolp.laplaceta.org" target="_blank" rel="noopener">BOLP</a><a href="/login">Acceso seguro</a></div></div></footer>
<script>
(() => {
  const slides = [...document.querySelectorAll('.carousel-slide')];
  const dots = [...document.querySelectorAll('.carousel-dot')];
  if (slides.length < 2) return;
  let current = 0;
  const show = (next) => {
    current = (next + slides.length) % slides.length;
    slides.forEach((slide, index) => slide.classList.toggle('is-active', index === current));
    dots.forEach((dot, index) => { dot.classList.toggle('is-active', index === current); dot.setAttribute('aria-selected', index === current ? 'true' : 'false'); });
  };
  dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
  window.setInterval(() => show(current + 1), 7000);
})();
</script>
</body>
</html>
