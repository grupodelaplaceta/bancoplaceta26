<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#21103f">
  <title><%= link ? 'Pago seguro · Banco de La Placeta' : 'Enlace no disponible · Banco de La Placeta' %></title>
  <style>
    :root{font-family:'Plus Jakarta Sans',ui-sans-serif,system-ui,-apple-system,sans-serif;color:#f8f5ff;background:#160c29}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 15% 5%,#5a2b9d 0,#29124c 32%,#160c29 72%);display:grid;place-items:center;padding:24px}
    .shell{width:min(100%,480px)}.brand{display:flex;align-items:center;gap:12px;margin:0 0 22px 4px}.mark{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:#7b3fd1;color:white;font-size:22px;font-weight:900;box-shadow:0 10px 30px #08031166}.brand strong{display:block;font-size:15px;letter-spacing:-.02em}.brand span{display:block;color:#d8cbed99;font-size:11px;margin-top:2px}
    .card{background:#fff;color:#241637;border:1px solid #ffffff33;border-radius:28px;padding:30px;box-shadow:0 24px 70px #08031166}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7540bb;margin:0 0 10px}.title{font-size:27px;line-height:1.15;letter-spacing:-.04em;margin:0 0 10px;color:#241637}.muted{color:#736681;font-size:14px;line-height:1.6}.amount{margin:24px 0;padding:20px;border-radius:20px;background:#f4effc;border:1px solid #e5d9f7}.amount small{display:block;color:#806d93;font-size:12px;font-weight:700}.amount strong{display:block;margin-top:5px;font-size:38px;letter-spacing:-.05em;color:#4d1b91}.rows{border-top:1px solid #eee7f5;margin-top:20px;padding-top:8px}.row{display:flex;justify-content:space-between;gap:20px;padding:12px 0;font-size:13px}.row span{color:#806d93}.row b{text-align:right;overflow-wrap:anywhere}.button{display:block;width:100%;border:0;border-radius:15px;background:#5b22a8;color:#fff;text-align:center;text-decoration:none;font-weight:800;padding:14px 16px;margin-top:22px;cursor:pointer}.button:hover{background:#45157f}.notice{padding:15px;border-radius:15px;background:#fff4f5;border:1px solid #ffd5da;color:#a32943;font-size:14px;line-height:1.5}.foot{text-align:center;color:#d8cbed99;font-size:11px;margin:18px 0 0}.secure{display:flex;justify-content:center;gap:6px;margin-top:18px;color:#806d93;font-size:11px;font-weight:700}.secure::before{content:'✓';color:#28a36a}@media(max-width:420px){body{padding:16px}.card{padding:22px;border-radius:22px}.title{font-size:24px}.amount strong{font-size:33px}}
  </style>
</head>
<body>
  <main class="shell">
    <div class="brand"><div class="mark">B</div><div><strong>Banco de La Placeta</strong><span>Economía virtual segura y comunitaria</span></div></div>
    <section class="card">
      <% if (error) { %>
        <p class="eyebrow">Enlace no disponible</p>
        <h1 class="title">No podemos validar este pago</h1>
        <p class="notice"><%= error %></p>
        <a class="button" href="https://banco.laplaceta.org/">Ir al banco</a>
      <% } else { %>
        <p class="eyebrow">Solicitud de pago</p>
        <h1 class="title"><%= link.concept || 'Pago seguro' %></h1>
        <p class="muted">Revisa los datos antes de continuar. Este enlace está firmado y solo muestra información verificada por Banco de La Placeta.</p>
        <div class="amount"><small>Total a pagar</small><strong><%= new Intl.NumberFormat('es-ES').format(Number(link.totalPz || 0)) %> Pz</strong></div>
        <div class="rows">
          <div class="row"><span>Base</span><b><%= new Intl.NumberFormat('es-ES').format(Number(link.amountPz || 0)) %> Pz</b></div>
          <% if (Number(link.ivaPz || 0) > 0) { %><div class="row"><span>IVA</span><b><%= new Intl.NumberFormat('es-ES').format(Number(link.ivaPz)) %> Pz</b></div><% } %>
          <div class="row"><span>Estado</span><b><%= link.status === 'Pending' ? 'Pendiente de pago' : 'Ya procesado' %></b></div>
        </div>
        <% if (link.status === 'Pending') { %>
          <a class="button" href="/auth/login?returnTo=<%= encodeURIComponent('/pagar/' + link.id + '?signature=' + signature) %>">Continuar con PlacetaID</a>
          <div class="secure">Enlace verificado · conexión protegida</div>
        <% } else { %>
          <p class="notice">Este enlace ya ha sido procesado y no admite un segundo pago.</p>
        <% } %>
      <% } %>
    </section>
    <p class="foot">Banco de La Placeta · Servicio sin ánimo de lucro · No compartas tus credenciales</p>
  </main>
</body>
</html>
