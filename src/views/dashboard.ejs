<%
  var total = cuentas.reduce(function(s, c) { return s + (c.balancePz || 0); }, 0);
  var principal = cuentas[0] || null;
%>
<div class="bw-page">
  <div class="bw-header">
    <div>
      <h1>Hola, <%- usuario.displayName || usuario.dip %> 👋</h1>
      <p class="bw-sub">DIP <strong><%= usuario.dip %></strong> · <%= usuario.censado ? 'Censado en Tributos' : 'Censo tributario pendiente' %></p>
    </div>
  </div>

  <% if (cuentas.length) { %>
  <div class="bw-hero">
    <div class="bw-hero-label">Saldo total</div>
    <div class="bw-hero-balance" data-count="<%= total %>">0</div>
    <div class="bw-hero-owner"><%- usuario.displayName || usuario.dip %> · <%= cuentas.length %> cuenta<%= cuentas.length > 1 ? 's' : '' %></div>
    <div class="bw-actions">
      <a class="bw-action" href="/transferencia">
        <span class="bw-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10V6h10M7 10l4-4M17 14v4H7M17 14l-4 4"/></svg></span>
        Transferir
      </a>
      <a class="bw-action" href="/movimientos">
        <span class="bw-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span>
        Movimientos
      </a>
      <a class="bw-action" href="/tarjetas">
        <span class="bw-action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2.5"/><path d="M2 10h20"/></svg></span>
        Tarjetas
      </a>
    </div>
  </div>
  <% } %>

  <div class="bw-grid">
    <% cuentas.forEach(function(cuenta) { %>
      <div class="bw-card bw-account <%= cuenta.closedAt ? 'bw-muted' : '' %>">
        <div class="bw-account-top">
          <span class="bw-chip"><%= cuenta.type %></span>
          <span class="bw-chip <%= cuenta.complianceStatus === 'Clear' ? 'bw-chip-soft' : 'bw-chip-warn' %>"><%= cuenta.complianceStatus %></span>
        </div>
        <div class="bw-account-name"><%- cuenta.displayName %></div>
        <div class="bw-account-iban">
          <%= cuenta.ibanFull || cuenta.iban %>
          <button type="button" class="bw-copy" data-copy="<%= cuenta.ibanFull || cuenta.iban %>" title="Copiar IBAN" aria-label="Copiar IBAN">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          </button>
        </div>
        <div class="bw-account-balance"><%= cuenta.balancePz.toLocaleString('es-ES') %> <span class="bw-cur">Pz</span></div>
        <% if (cuenta.eip) { %><div class="bw-account-eip">EIP: <strong><%= cuenta.eip %></strong></div><% } %>
      </div>
    <% }) %>
    <% if (!cuentas.length) { %>
      <div class="bw-card bw-empty">No tienes cuentas asociadas.</div>
    <% } %>
  </div>

  <% if (movimientos.length) { %>
  <div class="bw-card">
    <div class="bw-account-top">
      <strong>Últimos movimientos</strong>
      <a href="/movimientos" class="bw-btn bw-btn-ghost" style="padding:6px 12px;font-size:12.5px">Ver todos</a>
    </div>
    <table class="bw-table">
      <tbody>
        <% movimientos.slice(0, 5).forEach(function(m) { %>
          <tr>
            <td class="bw-muted" style="white-space:nowrap"><%= new Date(m.createdAt).toLocaleDateString('es-ES') %></td>
            <td><%- m.concept || m.kind %></td>
            <td class="<%= m.esEntrada ? 'bw-pos' : 'bw-neg' %>" style="text-align:right">
              <%= (m.esEntrada ? '+' : '−') %><%= m.amountPz.toLocaleString('es-ES') %> Pz
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
